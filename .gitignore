# Secrets and env
.env
.env.local
*.pem
*.key

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
.venv-preview/
venv/
.ipynb_checkpoints/

# Data — never commit raw or processed data; gitkeep preserves folder structure
data/raw/*
data/raw_archive/*
data/interim/*
data/processed/*
data/snapshots/*
!data/raw/.gitkeep
!data/raw_archive/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/snapshots/.gitkeep
*.parquet
*.csv
*.jsonl

# Private — handle ↔ peer_id mapping for the negative-peer protocol.
# Only `.template` schema files are committed; real handles never are.
data/private/*
!data/private/*.template

# Notebooks output
*-checkpoint.ipynb

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Claude Code worktrees (local-only)
.claude/worktrees/

# Build
dist/
build/
*.egg-info/
.gstack/
