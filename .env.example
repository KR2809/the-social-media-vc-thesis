# Anthropic — required for LLM signal scoring (Haiku default, Sonnet for taxonomy)
ANTHROPIC_API_KEY=

# YouTube Data API v3 — required for video-creator outcome data
YOUTUBE_API_KEY=

# Reddit — required for community signals
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=bba-thesis-signal-fund/0.1 by /u/<your_reddit_handle>

# Product Hunt — required for launch data
PRODUCTHUNT_DEV_TOKEN=

# OpenAI — optional fallback for embeddings
OPENAI_API_KEY=

# Crunchbase — if academic free tier is approved (2-week wait); leave empty otherwise
CRUNCHBASE_API_KEY=

# Hard monthly cap reminders (informational only — set the actual caps in each provider's console)
# ANTHROPIC_MONTHLY_BUDGET_USD=30
